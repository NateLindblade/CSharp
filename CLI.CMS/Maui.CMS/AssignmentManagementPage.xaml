<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.CMS.AssignmentManagementPage"
             Title="Assignments">

    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto,Auto" Padding="20">

        <CollectionView
            Grid.Row="0"
            x:Name="AssignmentsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Padding="0,10">
                        <Label
                            Grid.Column="0"
                            Text="{Binding Name}"
                            FontSize="18"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            Text="Grade"
                            Clicked="OnGradeClicked" />
                        <Button
                            Grid.Column="2"
                            Text="Edit"
                            Clicked="OnEditClicked" />
                        <Button
                            Grid.Column="3"
                            Text="Copy"
                            Clicked="OnCopyClicked" />
                        <Button
                            Grid.Column="4"
                            Text="Delete"
                            Clicked="OnDeleteClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="1"
            Text="Add Assignment"
            Clicked="OnAddClicked" />

        <Button
            Grid.Row="2"
            Text="Add Quiz"
            Clicked="OnAddQuizClicked" />

        <Button
            Grid.Row="3"
            Text="Export Assignments"
            Clicked="OnExportClicked" />

        <Button
            Grid.Row="4"
            Text="Import Assignments"
            Clicked="OnImportClicked" />

        <Button
            Grid.Row="5"
            Text="Back"
            Clicked="OnBackClicked" />

    </Grid>

</ContentPage>