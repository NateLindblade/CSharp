<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.CMS.RosterManagementPage"
             Title="Roster">

    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" Padding="20">

        <CollectionView
            Grid.Row="0"
            x:Name="RosterList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,10">
                        <Label
                            Grid.Column="0"
                            Text="{Binding Name}"
                            FontSize="18"
                            VerticalOptions="Center" />
                        <Button
                            Grid.Column="1"
                            Text="Remove"
                            Clicked="OnRemoveClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="1"
            Text="Add Student to Roster"
            Clicked="OnAddClicked" />

        <Button
            Grid.Row="2"
            Text="Export Roster"
            Clicked="OnExportClicked" />

        <Button
            Grid.Row="3"
            Text="Import Roster"
            Clicked="OnImportClicked" />

        <Button
            Grid.Row="4"
            Text="Back"
            Clicked="OnBackClicked" />

    </Grid>

</ContentPage>