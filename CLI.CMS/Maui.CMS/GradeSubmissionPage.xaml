<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.CMS.GradeSubmissionsPage"
             Title="Grade Submissions">

    <Grid RowDefinitions="*,Auto" Padding="20">

        <CollectionView
            Grid.Row="0"
            x:Name="SubmissionsList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding StudentName}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Summary}" FontSize="14" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Text="Open File"
                            IsVisible="{Binding HasFile}"
                            Clicked="OnOpenFileClicked" />
                        <Button
                            Grid.Column="2"
                            Text="Grade"
                            Clicked="OnGradeClicked" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="1"
            Text="Back"
            Clicked="OnBackClicked" />

    </Grid>

</ContentPage>